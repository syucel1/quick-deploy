{
  "Inventory": {
    "Path": "/var/lib/quickdeploy/inventory/demo.yaml"
  },
  "Discovery": {
    "SshExecutable": "ssh",
    "Profiles": {
      "demo-reader": {
        "User": "quickdeploy-reader",
        "IdentityFile": "/etc/quickdeploy/ssh/demo-reader",
        "KnownHostsFile": "/etc/quickdeploy/ssh/known_hosts",
        "AllowedHosts": ["demo-01.example.internal"]
      }
    }
  },
  "TeamCity": {
    "BaseUrl": "https://teamcity.example.internal",
    "Token": "",
    "RequireChecksum": false,
    "MaxArtifactBytes": 2147483648,
    "DownloadTimeoutMinutes": 30
  },
  "Artifacts": {
    "Path": "/var/lib/quickdeploy/artifacts"
  }
}
